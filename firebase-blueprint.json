{
  "entities": {
    "profiles": {
      "title": "User Profile",
      "description": "User profile data synced from Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase UID" },
        "full_name": { "type": "string" },
        "avatar_url": { "type": "string" },
        "role": { "type": "string", "enum": ["buyer", "seller", "broker", "admin"] },
        "bio": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role"]
    },
    "listings": {
      "title": "Listing",
      "description": "A structured business or asset listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seller_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "location": { "type": "string" },
        "revenue_range": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["seller_id", "title", "price"]
    },
    "messages": {
      "title": "Message",
      "description": "A chat message between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "receiver_id": { "type": "string" },
        "listing_id": { "type": "string" },
        "content": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["sender_id", "receiver_id", "content"]
    }
  },
  "firestore": {
    "profiles/{userId}": { "schema": "profiles", "description": "User profiles" },
    "listings/{listingId}": { "schema": "listings", "description": "Public listings" },
    "messages/{messageId}": { "schema": "messages", "description": "Direct messages" }
  }
}
